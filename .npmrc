# Never download a browser binary on `npm install` — this project only ever
# drives an already-installed Chrome/Edge, never Playwright's own bundled
# Chromium/Firefox/WebKit (see README "Browser choice"). This matters even
# though `playwright` (the full package, not just `playwright-core`) is now
# a dependency — it's needed only for its `codegen` CLI, used with
# `--channel chrome`/`--channel msedge` against the system browser, which
# never requires Playwright's own bundled browser at all.
#
# npm automatically exposes every key here to child processes (including a
# dependency's own postinstall script) as `npm_config_<key>`, which is what
# Playwright's installer checks for — this is the documented way to disable
# it without needing every developer/CI machine to also set the
# PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD environment variable by hand.
playwright_skip_browser_download=1

# Skip optionalDependencies entirely on every `npm install` — in particular
# @vscode/vsce's own optional deps, the per-platform @vscode/vsce-sign-*
# native binaries for its VSIX-signing feature, which this project's build
# (build-extension.bat -> `vsce package`, no signing flags) never uses. On a
# locked-down corporate npm registry (e.g. an Artifactory/Nexus mirror) that
# doesn't proxy those scoped packages, npm still tries to resolve every
# platform variant (including the one matching the current OS/arch) and
# fails loudly for each one — this skips that resolution entirely rather
# than relying on everyone remembering to pass a flag by hand. Safe: nothing
# here ships inside the built .vsix either way (`vsce` itself is a
# devDependency, never bundled into the packaged extension).
#
# Both keys set for the same thing since the config name changed across npm
# major versions — `omit` (npm 8+) is the current one; `optional` (pre-8) is
# the legacy equivalent, harmless to also set on newer npm. A too-old npm
# that recognizes neither just ignores them, same as before this file existed.
omit=optional
optional=false
